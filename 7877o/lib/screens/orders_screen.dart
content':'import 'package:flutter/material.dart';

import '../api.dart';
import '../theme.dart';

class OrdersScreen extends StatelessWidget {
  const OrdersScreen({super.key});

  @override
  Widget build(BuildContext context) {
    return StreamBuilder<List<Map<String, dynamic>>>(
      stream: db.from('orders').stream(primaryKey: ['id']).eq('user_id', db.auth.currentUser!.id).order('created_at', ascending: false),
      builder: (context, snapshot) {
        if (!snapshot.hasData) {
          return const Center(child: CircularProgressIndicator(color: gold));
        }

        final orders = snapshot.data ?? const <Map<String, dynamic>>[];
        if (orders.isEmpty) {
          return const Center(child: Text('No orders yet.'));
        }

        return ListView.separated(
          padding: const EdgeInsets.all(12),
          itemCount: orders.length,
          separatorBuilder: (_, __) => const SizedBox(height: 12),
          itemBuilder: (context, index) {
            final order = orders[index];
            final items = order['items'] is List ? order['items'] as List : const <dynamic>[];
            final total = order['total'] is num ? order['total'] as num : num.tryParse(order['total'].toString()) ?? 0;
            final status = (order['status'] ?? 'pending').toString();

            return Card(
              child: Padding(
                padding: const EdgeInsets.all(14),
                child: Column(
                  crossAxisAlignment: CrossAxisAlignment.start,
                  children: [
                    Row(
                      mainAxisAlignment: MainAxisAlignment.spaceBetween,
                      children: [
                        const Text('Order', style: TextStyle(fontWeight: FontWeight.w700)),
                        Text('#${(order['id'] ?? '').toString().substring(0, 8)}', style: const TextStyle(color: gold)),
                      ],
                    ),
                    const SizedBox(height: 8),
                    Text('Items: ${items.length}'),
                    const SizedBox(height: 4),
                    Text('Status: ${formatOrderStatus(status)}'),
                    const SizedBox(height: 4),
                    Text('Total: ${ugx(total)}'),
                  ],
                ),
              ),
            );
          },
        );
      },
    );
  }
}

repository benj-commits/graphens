class Cart extends ChangeNotifier {
  final Map<String, Map<String, dynamic>> _lines = {};

  Map<String, Map<String, dynamic>> get lines => _lines;

  int get count => _lines.values.fold<int>(0, (total, line) => total + ((line['qty'] as int?) ?? 0));

  int get total {
    var sum = 0;
    for (final line in _lines.values) {
      final product = line['p'] as Map<String, dynamic>;
      final qty = (line['qty'] as int?) ?? 0;
      final price = product['price'];
      final parsed = price is num ? price : num.tryParse(price.toString()) ?? 0;
      sum += (parsed * qty).round();
    }
    return sum;
  }

  void add(Map<String, dynamic> product) {
    final id = (product['id'] ?? '').toString();
    if (id.isEmpty) return;

    final line = _lines.putIfAbsent(id, () => {'p': product, 'qty': 0});
    line['qty'] = (line['qty'] as int) + 1;
    notifyListeners();
  }

  void setQty(String productId, int qty) {
    if (qty <= 0) {
      _lines.remove(productId);
      notifyListeners();
      return;
    }

    final line = _lines[productId];
    if (line == null) return;
    line['qty'] = qty;
    notifyListeners();
  }

  void clear() {
    _lines.clear();
    notifyListeners();
  }
}

