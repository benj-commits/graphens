String myFirstName() {
  final fullName = db.auth.currentUser?.userMetadata?['full_name']?.toString() ?? '';
  final cleaned = fullName.trim();
  if (cleaned.isEmpty) return 'Customer';
  return cleaned.split(RegExp(r'\s+')).first;
}

